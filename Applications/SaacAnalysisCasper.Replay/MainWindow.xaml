<Window x:Class="SaacAnalysisCasper.Replay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaacAnalysisCasper Replay"
        Width="720"
        Height="520"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <GroupBox Grid.Row="0" Header="Dataset (.pds)" Margin="0,0,0,8" Padding="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="DatasetPathTextBox"
                 Grid.Column="0"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Margin="0,0,8,0" />
        <Button x:Name="BrowseDatasetButton"
                Grid.Column="1"
                Content="Browse…"
                Padding="12,4"
                Click="BrowseDataset_Click" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Header="Session" Margin="0,0,0,8" Padding="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="Select session:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <ComboBox x:Name="SessionComboBox"
                  Grid.Column="1"
                  IsEditable="False" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="2" Header="Run config (Core AnalysisRunConfig JSON)" Margin="0,0,0,8" Padding="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="RunConfigPathTextBox"
                 Grid.Column="0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,8,0" />
        <Button x:Name="BrowseRunConfigButton"
                Grid.Column="1"
                Content="Browse…"
                Padding="12,4"
                Click="BrowseRunConfig_Click" />
      </Grid>
    </GroupBox>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="RunButton"
              Content="Run offline Replay"
              Padding="16,6"
              Click="Run_Click" />
      <TextBlock x:Name="StatusTextBlock"
                 Margin="16,0,0,0"
                 VerticalAlignment="Center"
                 Text="Idle" />
    </StackPanel>

    <GroupBox Grid.Row="4" Header="Log" Padding="6">
      <TextBox x:Name="LogTextBox"
               IsReadOnly="True"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               FontFamily="Consolas"
               FontSize="12" />
    </GroupBox>
  </Grid>
</Window>
